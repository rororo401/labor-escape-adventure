class_name ResultPopupLayoutStore
extends RefCounted

const JsonFileLoaderScript := preload("res://scripts/core/json_file_loader.gd")
const ResultPopupOverlayConfigScript := preload("res://scripts/ui/result_popup_overlay_config.gd")

const NOTE := "Generated by ResultPopupLayoutCalibrator. Values are UI positions in 720x1280 coordinates."
const CURRENT_VERSION := 2
const LEGACY_RIGHT_ALIGNED_ROW_VALUE_X := 420.0

var user_path := ResultPopupOverlayConfigScript.USER_OVERRIDE_PATH
var default_path := ResultPopupOverlayConfigScript.DEFAULT_OVERRIDE_PATH


func load_layout() -> Dictionary:
	for path in [user_path, default_path]:
		var loaded := JsonFileLoaderScript.read_dictionary(String(path), "result popup layout override JSON", false)
		if String(loaded.get(JsonFileLoaderScript.KEY_ERROR, "")) == JsonFileLoaderScript.ERROR_FILE_MISSING:
			continue
		if bool(loaded.get(JsonFileLoaderScript.KEY_OK, false)):
			return _normalize_loaded_data(Dictionary(loaded.get(JsonFileLoaderScript.KEY_DATA, {})))
	return ResultPopupOverlayConfigScript.default_layout()


func save_layout(layout: Dictionary) -> bool:
	var normalized := normalize_layout(layout)
	var text := JSON.stringify({
		ResultPopupOverlayConfigScript.KEY_VERSION: CURRENT_VERSION,
		ResultPopupOverlayConfigScript.KEY_NOTE: NOTE,
		ResultPopupOverlayConfigScript.KEY_LAYOUT: normalized
	}, "\t")
	var ok := _write_text(user_path, text)
	_write_text(default_path, text)
	return ok


static func normalize_layout(layout: Dictionary) -> Dictionary:
	var defaults := ResultPopupOverlayConfigScript.default_layout()
	return {
		ResultPopupOverlayConfigScript.KEY_PANEL_POSITION: _vector_payload(layout.get(ResultPopupOverlayConfigScript.KEY_PANEL_POSITION, defaults.get(ResultPopupOverlayConfigScript.KEY_PANEL_POSITION))),
		ResultPopupOverlayConfigScript.KEY_TITLE_POSITION: _vector_payload(layout.get(ResultPopupOverlayConfigScript.KEY_TITLE_POSITION, defaults.get(ResultPopupOverlayConfigScript.KEY_TITLE_POSITION))),
		ResultPopupOverlayConfigScript.KEY_ROW_LABEL_X: float(layout.get(ResultPopupOverlayConfigScript.KEY_ROW_LABEL_X, defaults.get(ResultPopupOverlayConfigScript.KEY_ROW_LABEL_X))),
		ResultPopupOverlayConfigScript.KEY_ROW_VALUE_X: float(layout.get(ResultPopupOverlayConfigScript.KEY_ROW_VALUE_X, defaults.get(ResultPopupOverlayConfigScript.KEY_ROW_VALUE_X))),
		ResultPopupOverlayConfigScript.KEY_ROW_Y: _row_y_payload(layout.get(ResultPopupOverlayConfigScript.KEY_ROW_Y, defaults.get(ResultPopupOverlayConfigScript.KEY_ROW_Y))),
		ResultPopupOverlayConfigScript.KEY_CLOSE_BUTTON_POSITION: _vector_payload(layout.get(ResultPopupOverlayConfigScript.KEY_CLOSE_BUTTON_POSITION, defaults.get(ResultPopupOverlayConfigScript.KEY_CLOSE_BUTTON_POSITION)))
	}


static func vector_from_payload(value, fallback: Vector2) -> Vector2:
	if value is Vector2:
		return value
	if typeof(value) == TYPE_DICTIONARY:
		var row := Dictionary(value)
		return Vector2(float(row.get(ResultPopupOverlayConfigScript.KEY_X, fallback.x)), float(row.get(ResultPopupOverlayConfigScript.KEY_Y, fallback.y)))
	if typeof(value) == TYPE_ARRAY:
		var row: Array = value
		if row.size() >= 2:
			return Vector2(float(row[0]), float(row[1]))
	return fallback


static func _vector_payload(value) -> Dictionary:
	var vector := vector_from_payload(value, Vector2.ZERO)
	return {
		ResultPopupOverlayConfigScript.KEY_X: vector.x,
		ResultPopupOverlayConfigScript.KEY_Y: vector.y
	}


static func _row_y_payload(value) -> Array:
	var defaults: Array = ResultPopupOverlayConfigScript.ROW_Y.duplicate()
	var source: Array = []
	if typeof(value) == TYPE_ARRAY:
		source = Array(value)
	var row_y: Array = []
	for index in ResultPopupOverlayConfigScript.RESULT_ROW_COUNT:
		var fallback := float(defaults[index])
		row_y.append(float(source[index]) if index < source.size() else fallback)
	return row_y


func _write_text(path: String, text: String) -> bool:
	if path.is_empty():
		return false
	var file := FileAccess.open(path, FileAccess.WRITE)
	if file == null:
		push_warning("Could not write result popup layout override: %s" % path)
		return false
	file.store_string(text)
	file.close()
	return true


static func _normalize_loaded_data(data: Dictionary) -> Dictionary:
	var version := int(data.get(ResultPopupOverlayConfigScript.KEY_VERSION, 0))
	var normalized := normalize_layout(data.get(ResultPopupOverlayConfigScript.KEY_LAYOUT, {}))
	if version < CURRENT_VERSION and is_equal_approx(
		float(normalized.get(ResultPopupOverlayConfigScript.KEY_ROW_VALUE_X, ResultPopupOverlayConfigScript.ROW_VALUE_X)),
		LEGACY_RIGHT_ALIGNED_ROW_VALUE_X
	):
		normalized[ResultPopupOverlayConfigScript.KEY_ROW_VALUE_X] = ResultPopupOverlayConfigScript.ROW_VALUE_X
	return normalized
